DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent redirect loops for internal rewrites
    RewriteCond %{ENV:REDIRECT_STATUS} 200
    RewriteRule ^ - [L]

    # 1. External Redirect: Remove .php from URL on GET requests
    # Exclude POST requests and API requests so API endpoints are never redirected
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{REQUEST_URI} !/api/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
    RewriteRule ^ %1 [R=301,L]

    # Route bookings before Apache handles the sibling helper directory.
    RewriteRule ^public/admin/bookings/?$ public/admin/bookings.php [L,QSA]

    # 2. Internal Rewrite: Map clean URL to .php file if file.php exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*?)/?$ $1.php [L,QSA]
</IfModule>
