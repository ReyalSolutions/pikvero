DirectoryIndex index.php index.html
Options -Indexes
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
    <Files "service-worker.js">
        Header set Cache-Control "no-cache"
        Header set Service-Worker-Allowed "/"
    </Files>
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:pikvero/)?(?:app|database|tests|vendor|\.git|\.codex|\.agents)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:pikvero/)?(?:debug|phpinfo)(?:\.php)?$ - [F,L,NC]
    RewriteRule (?:^|/)\.(?!well-known/) - [F,L]
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Root hosting layout: serve legacy /pikvero/ links from this project root.
    # Match extensionless PHP routes directly before the internal-rewrite guard.
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^pikvero/(.*?)/?$ $1.php [L,QSA]
    RewriteRule ^pikvero/(.*)$ $1 [L,QSA]

    # Prevent redirect loops for internal rewrites
    RewriteCond %{ENV:REDIRECT_STATUS} 200
    RewriteRule ^ - [L]

    # 1. External Redirect: Remove .php from URL on GET requests
    # Exclude POST requests and API requests so API endpoints are never redirected
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{REQUEST_URI} !/api/ [NC]
    RewriteCond %{REQUEST_URI} !/public/manifest\.php$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
    RewriteRule ^ %1 [R=301,L]

    # Route bookings before Apache handles the sibling helper directory.
    RewriteRule ^public/admin/bookings/?$ public/admin/bookings.php [L,QSA]

    # 2. Internal Rewrite: Map clean URL to .php file if file.php exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*?)/?$ $1.php [L,QSA]
</IfModule>
